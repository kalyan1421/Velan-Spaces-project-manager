# Docker Compose variables for docker-compose.yml.
# Copy to the repo root as `.env` (Compose reads it automatically), or pass
# `--env-file /etc/velan/compose.env`. Nothing in here is secret.
# API secrets do NOT go here — they live in API_ENV_FILE (see below).

# --- Public URLs (required) -----------------------------------------------------
# Public https URL of the web app, no trailing slash. TODO(client): real domain.
# Also passed to the API as APP_PUBLIC_URL (invite / password-reset links, emails).
APP_URL=https://velanspaces.example

# --- API secrets file ---------------------------------------------------------
# Path to the API env file (template: velan-backend/.env.example). Keeping it
# outside the repo checkout (e.g. /etc/velan/api.env, chmod 600) is recommended.
# All API settings go there, not here: SUPABASE_URL / SUPABASE_PUBLIC_URL / keys,
# TRUST_PROXY_HOPS, SMTP_* + MAIL_FROM + ENQUIRY_NOTIFY_EMAILS (enquiry emails),
# FIREBASE_*, GOOGLE_CLIENT_IDS. See deploy/DEPLOYMENT.md §4.2.
API_ENV_FILE=./velan-backend/.env

# --- Web build-time values (baked into the web image; rebuild after changing) --
# Canonical public origin used for SEO (sitemap, canonical/OG URLs). Defaults to APP_URL.
NEXT_PUBLIC_SITE_URL=
# Supabase Storage host(s) next/image may load from, comma-separated:
#   Supabase Cloud:  <project-ref>.supabase.co
#   Self-hosted:     supabase.example.com   (add :port if not 443)
# Empty = any *.supabase.co (fine for testing, set it for production).
IMAGE_REMOTE_HOSTS=
# "true" only if Supabase Storage resolves to a private/LAN IP (SSRF risk otherwise).
IMAGE_ALLOW_LOCAL_IP=
# Google sign-in button on the web login page. Empty = button hidden.
# Must also be listed in the API's GOOGLE_CLIENT_IDS.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Host port bindings --------------------------------------------------------
# Loopback by default so only the reverse proxy can reach the containers.
BIND_ADDR=127.0.0.1
API_PORT=3000
WEB_PORT=3100

# --- Image naming (useful when pushing to a private registry) -------------------
IMAGE_PREFIX=velan
IMAGE_TAG=latest

# --- Caddy reverse proxy (only with `docker compose --profile proxy`) -------------
# DNS A/AAAA records for both names must point at this server before first start.
SITE_DOMAIN=velanspaces.example
API_DOMAIN=api.velanspaces.example
ACME_EMAIL=ops@velanspaces.example
