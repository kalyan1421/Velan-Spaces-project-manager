rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── MANAGERS ──────────────────────────────────────────────────────────────
    // Manager login queries by name BEFORE Firebase Auth sign-in completes.
    // Password verification is done in-app — Firestore only stores the record.
    match /managers/{managerId} {
      allow read: if true;                       // pre-auth login lookup
      allow write: if request.auth != null;
    }

    // ─── WORKERS ───────────────────────────────────────────────────────────────
    // Same: worker login looks up by name before auth.
    match /workers/{workerId} {
      allow read: if true;                       // pre-auth login lookup
      allow write: if request.auth != null;
    }

    // ─── PROJECTS ──────────────────────────────────────────────────────────────
    // Client login calls getProjectById(code) BEFORE Firebase Auth.
    // After login all authenticated roles (admin/manager/worker/client) need
    // full read access to projects they belong to.
    // We keep it open to any authenticated user — role filtering is done in-app.
    match /projects/{projectId} {
      // Allow pre-auth read for client login (project code lookup)
      allow read: if true;

      // Only authenticated users can mutate projects
      allow write: if request.auth != null;

      // Sub-collections: updates, designs, rooms, budget, settlements, timeline …
      match /{subcollection}/{docId} {
        allow read: if request.auth != null;     // project data requires authenticated session
        allow write: if request.auth != null;
      }
    }

    // ─── USERS ─────────────────────────────────────────────────────────────────
    // FCM tokens + notification state.
    match /users/{userId} {
      allow read, write: if request.auth != null;

      match /notifications/{notifId} {
        allow read, delete, update: if request.auth != null;
        allow create: if request.auth != null;
      }
    }

    // ─── ADMIN CONFIG ──────────────────────────────────────────────────────────
    match /admin/{docId} {
      allow read, write: if request.auth != null;
    }

    // ─── SALES / LEADS ─────────────────────────────────────────────────────────
    match /leads/{leadId} {
      allow read, write: if request.auth != null;
    }

    // ─── WEBSITE PORTFOLIO ─────────────────────────────────────────────────────
    match /portfolio/{docId} {
      allow read: if true;                       // public website
      allow write: if request.auth != null;
    }

    // ─── DEFAULT DENY ──────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
