# ============================================================================
# Velan Spaces backend — environment template. Copy to `.env` and fill in.
# NEVER commit the real .env (see .gitignore).
# ============================================================================

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://bfhucobzpgsqazaqcyeo.supabase.co
# Address phones/browsers use to reach Supabase Storage, if different from
# SUPABASE_URL (self-hosted behind an internal Docker hostname). Signed URLs
# given to clients use it. Leave unset when SUPABASE_URL is already public.
# SUPABASE_PUBLIC_URL=https://supabase.example.com
# Public client key (safe in the Flutter app). Used by the app, not the backend.
SUPABASE_ANON_KEY=
# Service-role key — SECRET. Backend-only. Bypasses RLS. Never ship to client.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection (Settings → Database → Connection string → URI).
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.bfhucobzpgsqazaqcyeo.supabase.co:5432/postgres
# JWT secret (Settings → API → JWT Settings) for verifying Supabase tokens.
SUPABASE_JWT_SECRET=

# --- App --------------------------------------------------------------------
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# Comma-separated browser origins allowed by CORS (the Flutter web build).
# Native mobile apps ignore CORS. In production, unset = CORS disabled.
CORS_ORIGINS=
# Swagger UI at /docs. Defaults to on in development, off in production.
# ENABLE_SWAGGER=true
# Reverse-proxy hops in front of the API (Render/Railway = 1) so rate limiting
# sees the real client IP. 0 when running locally.
TRUST_PROXY_HOPS=0

# --- FCM (push via Firebase Admin, messaging only) --------------------------
# Path to the Firebase service account JSON (kept out of git) — local dev.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-admin.json
# OR the service account JSON inline / base64-encoded — for PaaS hosts.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Email (SMTP) -----------------------------------------------------------
# Website enquiries are emailed to the team (and shown in the dashboard).
# Leave SMTP_HOST unset to disable email (the API logs one warning).
# Links in emails/invites point at the web app (default http://localhost:3100).
# APP_PUBLIC_URL=https://app.example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# true = implicit TLS (port 465); false = STARTTLS / plain. Default: 465 -> true.
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# Sender address shown to recipients (defaults to SMTP_USER).
# MAIL_FROM="Velan Spaces <no-reply@example.com>"
# Comma-separated recipients for website enquiries (default: all active heads).
# ENQUIRY_NOTIFY_EMAILS=sales@example.com,owner@example.com
