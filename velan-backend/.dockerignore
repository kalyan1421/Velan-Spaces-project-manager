# Keep the build context small and free of secrets / data.
# The image only needs: package*.json, nest-cli.json, tsconfig*.json, src/.

# Dependencies & build output (rebuilt inside the image)
node_modules
dist
build
coverage
*.tsbuildinfo

# Secrets — NEVER send to the Docker daemon
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json
firebase-admin*.json

# Seed / ETL scripts and their exported data (may contain production data)
scripts
scripts/etl/data

# Database migrations & local Supabase state (applied separately, not shipped)
supabase

# Tests
**/*.spec.ts
test

# VCS, CI, editor, OS, logs
.git
.github
.vscode
.idea
.DS_Store
*.log
npm-debug.log*
Dockerfile
.dockerignore
*.md
