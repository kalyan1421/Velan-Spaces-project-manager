# Keep the build context small and free of secrets.

# Dependencies & build output (rebuilt inside the image)
node_modules
.next
out
build
coverage
*.tsbuildinfo

# Secrets / local env — NEVER send to the Docker daemon. Build-time values are
# passed as --build-arg; runtime values as container env.
.env
.env.*
*.pem
*.key

# VCS, CI, editor, OS, logs
.git
.github
.vscode
.idea
.vercel
.DS_Store
*.log
npm-debug.log*
Dockerfile
.dockerignore
